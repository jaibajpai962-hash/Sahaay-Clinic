# ==============================================================================
# FILE: .env.example  —  Sahaay Clinic Environment Variables Template
# ==============================================================================
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in EVERY value marked  <REQUIRED>
#   3. Never commit your .env file to Git  (it is in .gitignore)
#
# SYNTAX RULES:
#   KEY=value            → no spaces around the = sign
#   KEY="value with spaces"  → quote values that contain spaces
#   KEY=             → empty = feature disabled (where supported)
#   # comment         → lines starting with # are ignored
#
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. FLASK CORE
# ------------------------------------------------------------------------------

# A long, random string used to sign session cookies and JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# <REQUIRED>
SECRET_KEY=your_secret_key_here

# Flask environment: "development" | "production" | "testing"
# development  → debug mode ON, detailed error pages
# production   → debug mode OFF, safe error messages only
FLASK_ENV=development

# Set to "1" to enable Flask debug mode (auto-reload + debugger)
# NEVER set to 1 in production
FLASK_DEBUG=1

# Host and port the Flask dev server listens on
FLASK_HOST=0.0.0.0
FLASK_PORT=5000


# ------------------------------------------------------------------------------
# 2. DATABASE
# ------------------------------------------------------------------------------

# SQLAlchemy database URL.
#
# SQLite (development — no setup needed, file created automatically):
#   DATABASE_URL=sqlite:///sahaay_clinic.db
#
# PostgreSQL (production recommended):
#   DATABASE_URL=postgresql://username:password@localhost:5432/sahaay_clinic
#
# MySQL:
DATABASE_URL=sqlite:///sahaay_clinic.db
#
#DATABASE_URL=mysql+mysqlconnector://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:21402/sahaay_clinic

# Set to "true" to echo all SQL queries to the console (useful for debugging)
DB_ECHO=false


# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------

# Secret key specifically for JWT signing (can be the same as SECRET_KEY, but
# best practice is to use a separate key).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# <REQUIRED>
JWT_SECRET_KEY=dfhsfd536345t&^*#&sfuhuig

# How long an access token stays valid.
# Format: integer + unit (minutes, hours, days)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# How long a refresh token is valid (optional — set 0 to disable refresh)
JWT_REFRESH_TOKEN_EXPIRES_DAYS=365


# ------------------------------------------------------------------------------
# 4. GEMINI API (PRIMARY AI ENGINE)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio.
GEMINI_API_KEY=AQ.Ab8RN6J*********jsy************************************
GEMINI_MODEL=models/gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=800
GEMINI_TIMEOUT=45


# ------------------------------------------------------------------------------
# 5. TWILIO  (used for SMS alerts — optional)
# ------------------------------------------------------------------------------

# Get these from: https://console.twilio.com/
# Leave ALL THREE empty to disable SMS completely.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SMS template for patient alerts (use {name} and {message} as placeholders)
SMS_TEMPLATE=Sahaay Clinic: Dear {name}, {message}


# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------

# Comma-separated list of allowed origins for the API.
# In development: use *
# In production: use your actual domain(s)
# Example: https://sahaay.example.com,https://doctor.sahaay.com
CORS_ORIGINS=*

# Allowed HTTP methods (comma-separated)
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS


# ------------------------------------------------------------------------------
# 7. RATE LIMITING
# ------------------------------------------------------------------------------

# Max requests per window per IP address
RATE_LIMIT_PER_MINUTE=60

# Max login attempts before temporary lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15


# ------------------------------------------------------------------------------
# 8. LOGGING
# ------------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log file path (relative to backend/ directory)
# Leave empty to log to console only
LOG_FILE=logs/sahaay_clinic.log

# Maximum log file size in bytes before rotation (10 MB default)
LOG_MAX_BYTES=10485760

# Number of rotated log files to keep
LOG_BACKUP_COUNT=5


# ------------------------------------------------------------------------------
# 9. TELECONSULT
# ------------------------------------------------------------------------------

# Video conferencing platform integration (optional).
# Currently supported: "jitsi" | "none"
# "jitsi" uses free Jitsi Meet rooms — no API key needed.
TELECONSULT_PROVIDER=jitsi

# Base URL for Jitsi Meet (use your self-hosted instance or the public one)
JITSI_BASE_URL=https://meet.jit.si


# ------------------------------------------------------------------------------
# 10. APPLICATION SETTINGS
# ------------------------------------------------------------------------------

# Clinic name shown in notifications and reports
CLINIC_NAME=Sahaay Clinic

# Clinic district / region code (used in patient ID prefix)
CLINIC_DISTRICT_CODE=MH

# Admin email for system alerts (optional)
ADMIN_EMAIL=admin@sahaay-clinic.example.com

# How many days of patient queue history to keep in the active queue view
QUEUE_HISTORY_DAYS=1

# Default page size for paginated list endpoints
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200


# ------------------------------------------------------------------------------
# 11. SMTP EMAIL  (used for password reset / notifications)
# ------------------------------------------------------------------------------

# SMTP server hostname (Gmail: smtp.gmail.com  |  Outlook: smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Your sending email address and app-specific password
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# "From" address shown in sent emails
SMTP_FROM=noreply@sahaay-clinic.example.com


# ------------------------------------------------------------------------------
# 12. CLOUDINARY  (media file storage — images, audio, video)
# ------------------------------------------------------------------------------

# Get these from: https://cloudinary.com/console
# Leave ALL THREE empty to store files locally in backend/uploads/ instead.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ------------------------------------------------------------------------------
# 13. APPLICATION BASE URL  (used in password-reset email links)
# ------------------------------------------------------------------------------

# The public URL your app is served at. In development this is localhost.
# In production use your actual domain: https://sahaay.example.com
APP_BASE_URL=http://localhost:5000


# MySQL connection (direct connector — no SQLAlchemy URL needed)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=sahaay_clinic
